# ---------------------------------------------------------------------------
# M4 backend configuration. Copy to `.env` (same folder) and adapt.
# Never commit the real .env file.
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Security — generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when APP_ENV=production. In development an ephemeral secret is used if empty.
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_SECURE=false

# Allowed browser origins (comma separated) — the Vite dev server by default
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database — SQLite file by default (no server required). PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://m4_user:change-me@localhost:5432/m4
DATABASE_URL=sqlite:///./data/m4.db

# Data source manifest (relative to M4-Mahdi/)
DATA_SOURCES_FILE=data/input/sources.yml

# Optimization solver (appsi_highs or highs)
SOLVER_NAME=appsi_highs
SOLVER_TIME_LIMIT_SECONDS=120

# LLM provider (OpenAI-compatible chat completions API). Leave LLM_API_KEY empty to run
# the agent in deterministic mode. The key stays in the backend; it is never sent to the browser.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.1

# DEVELOPMENT demo accounts created by scripts/seed_demo.py (refused in production).
# Change these values; they are not production credentials.
DEMO_ADMIN_EMAIL=admin@m4.local
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=DemoAdmin-2026
DEMO_USER_EMAIL=planner@m4.local
DEMO_USER_USERNAME=planner
DEMO_USER_PASSWORD=DemoPlanner-2026

# First administrator (optional; used by scripts/create_admin.py if set, otherwise prompted)
# M4_ADMIN_EMAIL=
# M4_ADMIN_USERNAME=
# M4_ADMIN_PASSWORD=
