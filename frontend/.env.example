# Base URL of the API as seen by the browser. Leave empty to use the Vite proxy (recommended):
# requests go to /api on the same origin and are forwarded to VITE_BACKEND_URL.
VITE_API_BASE_URL=
# Backend address used by the Vite dev/preview proxy
# Use 127.0.0.1 rather than localhost: Node may resolve localhost to IPv6 (::1) while uvicorn listens on IPv4.
VITE_BACKEND_URL=http://127.0.0.1:8000
